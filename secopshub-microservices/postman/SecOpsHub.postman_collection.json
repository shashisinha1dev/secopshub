    {
      "name": "Create incident",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/incidents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "incidents"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Repeated failed logins followed by successful login\",\n  \"description\": \"Several failed logins were followed by a successful login from an unusual IP address.\",\n  \"incidentType\": \"UNAUTHORIZED_ACCESS\",\n  \"natureOfViolation\": \"ACCESS_CONTROL\",\n  \"severity\": \"HIGH\",\n  \"classificationStatus\": \"SUSPECTED\",\n  \"reportedBy\": \"soc.analyst@example.test\",\n  \"assignedTo\": \"tier2.analyst@example.test\",\n  \"businessUnit\": \"Information Technology\",\n  \"policyReference\": \"IAM-STD-004\",\n  \"occurredAt\": \"2026-10-16T09:05:00\",\n  \"detectedAt\": \"2026-10-16T09:10:00\",\n  \"reportedAt\": \"2026-10-16T09:20:00\",\n  \"businessImpact\": \"Potential unauthorized account access; impact not confirmed.\",\n  \"rootCause\": \"\",\n  \"correctiveAction\": \"Investigate sign-in events and validate MFA status.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created incident', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "if (body.incidentId) pm.collectionVariables.set('incidentId', body.incidentId);",
              "pm.test('Incident ID returned', function () { pm.expect(body.incidentId).to.be.a('string'); });"
            ]
          }
        }
      ]
    },

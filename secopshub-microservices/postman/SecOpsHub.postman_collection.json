    {
      "name": "Submit simulated security alert (async)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/alerts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "alerts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"externalAlertId\": \"{{alertExternalId}}\",\n  \"source\": \"SIMULATED_SIEM\",\n  \"title\": \"Repeated failed logins followed by unusual successful login\",\n  \"description\": \"A simulated SIEM alert reports multiple failed logins followed by a successful login from an unfamiliar IP address.\",\n  \"incidentType\": \"UNAUTHORIZED_ACCESS\",\n  \"natureOfViolation\": \"ACCESS_CONTROL\",\n  \"severity\": \"HIGH\",\n  \"classificationStatus\": \"SUSPECTED\",\n  \"reportedBy\": \"siem.connector@example.test\",\n  \"assignedTo\": \"tier2.analyst@example.test\",\n  \"businessUnit\": \"Information Technology\",\n  \"policyReference\": \"IAM-STD-004\",\n  \"occurredAt\": \"2026-10-16T09:05:00\",\n  \"detectedAt\": \"2026-10-16T09:10:00\",\n  \"reportedAt\": \"2026-10-16T09:20:00\",\n  \"businessImpact\": \"Potential account compromise; impact not confirmed.\",\n  \"rootCause\": \"\",\n  \"correctiveAction\": \"Review sign-in events and verify MFA status.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const externalId = 'DEMO-SIEM-' + pm.variables.replaceIn('{{$guid}}');",
              "pm.collectionVariables.set('alertExternalId', externalId);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Alert accepted for asynchronous processing', function () { pm.response.to.have.status(202); });",
              "const body = pm.response.json();",
              "if (body.externalAlertId) pm.collectionVariables.set('alertExternalId', body.externalAlertId);",
              "if (body.alertId) pm.collectionVariables.set('alertId', body.alertId);",
              "pm.test('Alert ID returned', function () { pm.expect(body.alertId).to.be.a('string'); });"
            ]
          }
        }
      ],
      "description": "Creates an alert and publishes AlertReceivedEvent to RabbitMQ. Expected status is 202 Accepted; incident creation happens asynchronously."
    },

  "item": [
    {
      "name": "Login as Incident Manager (run first)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login successful', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
              "if (body.username) pm.collectionVariables.set('username', body.username);",
              "pm.test('JWT access token saved', function () { pm.expect(body.accessToken).to.be.a('string').and.not.empty; });",
              "console.log('Authenticated user:', body.username, 'roles:', body.roles);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"manager@secopshub.local\",\n  \"password\": \"Manager@123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "description": "Run this first. Saves accessToken. This role can run all sample workflows, including severity changes."
      },
      "auth": {
        "type": "noauth"
      }
